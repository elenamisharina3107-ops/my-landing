<section class="contacts" id="contacts">
  <h2>Контакты</h2>
  <dl class="contacts__list">
    <div><dt>Телефон</dt><dd><a href="tel:{{ settings.phone | replace(r/[^\d+]/g, '') }}">{{ settings.phone }}</a></dd></div>
    <div><dt>Почта</dt><dd><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></dd></div>
    <div><dt>Адрес</dt><dd>{{ settings.address }}</dd></div>
    <div><dt>Часы работы</dt><dd>{{ settings.hours }}</dd></div>
  </dl>
  {% if settings.socials %}
    <ul class="contacts__socials">
      {% for s in settings.socials %}
        <li><a href="{{ s.url }}">{{ s.label }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
