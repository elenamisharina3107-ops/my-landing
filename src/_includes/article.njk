<!DOCTYPE html>
{# Шаблон статьи блога. Статья — файл src/blog/*.md с полями:
   title, description, date, seoTitle (необязательно), cta, ctaLink, ctaButton.
   Пока в статье стоит draft: true, на сайт она не попадает. #}
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seoTitle or title }} — Vireflow</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="https://vireflow.ru{{ page.url }}">
    <meta name="robots" content="index, follow">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="https://vireflow.ru{{ page.url }}">
    <meta property="og:image" content="https://vireflow.ru/uploads/og-image.jpg">
    <meta property="og:locale" content="ru_RU">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "datePublished": "{{ page.date.toISOString().slice(0, 10) }}",
      "inLanguage": "ru",
      "mainEntityOfPage": "https://vireflow.ru{{ page.url }}",
      "image": "https://vireflow.ru/uploads/og-image.jpg",
      "author": { "@type": "Person", "name": "Елена Мишарина", "url": "https://vireflow.ru/" },
      "publisher": { "@type": "Organization", "name": "Vireflow", "url": "https://vireflow.ru/" }
    }
    </script>
    <link rel="icon" href="/uploads/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/uploads/favicon-96.png?v=2" sizes="96x96" type="image/png">
    <link rel="apple-touch-icon" href="/uploads/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/site.css?v=3">
    <style>
        .article-container { max-width: 750px; margin: 0 auto; padding: 60px 20px; }
        .article-container h1 { font-size: 36px; font-weight: 800; margin: 32px 0 16px 0; line-height: 1.2; }
        .article-container h2 { font-size: 24px; font-weight: 700; margin: 40px 0 16px 0; line-height: 1.3; }
        .article-container h3 { font-size: 18px; font-weight: 600; margin: 24px 0 12px 0; }
        .article-container p { margin-bottom: 16px; color: #f0f0f5; font-size: 16px; line-height: 1.8; }
        .article-container ul, .article-container ol { margin: 16px 0 16px 24px; color: #f0f0f5; font-size: 16px; line-height: 1.7; }
        .article-container li { margin-bottom: 10px; }
        .article-container strong { font-weight: 600; color: #f0f0f5; }
        .article-container a { color: #4a9eff; }
        .article-container table { width: 100%; margin: 24px 0; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
        .article-container td, .article-container th { padding: 12px; border: 1px solid #1a2545; color: #f0f0f5; vertical-align: top; }
        .article-container th { background: #0f1428; font-weight: 600; text-align: left; }
        .article-container blockquote { background: #0f1428; border-left: 3px solid #4a9eff; padding: 16px 20px; margin: 24px 0; border-radius: 8px; }
        .article-container blockquote p { margin: 0; }
        .article-date { color: #4a9eff; font-size: 14px; margin-bottom: 32px !important; }
        .cta-box { background: #0f1428; border: 1px solid #1a2545; padding: 28px 24px; border-radius: 12px; margin: 40px 0; text-align: center; }
        .cta-box p { margin-bottom: 16px; }
        .cta-box a { background: #4a9eff; color: #fff; padding: 12px 28px; border-radius: 8px; text-decoration: none; display: inline-block; font-weight: 600; }
        .cta-box a:hover { opacity: 0.9; }
        .read-more { margin-top: 48px; padding-top: 32px; border-top: 1px solid #1a2545; }
        .read-more h2 { font-size: 20px; margin-top: 0; }
        .read-more ul { list-style: none; margin-left: 0; }
        .read-more a { text-decoration: none; font-weight: 500; }
        .read-more a:hover { text-decoration: underline; }
        .back-link { display: inline-block; margin-top: 32px; }
        .back-link a { color: #4a9eff; text-decoration: none; }
        @media (max-width: 768px) { .article-container h1 { font-size: 28px; } .article-container h2 { font-size: 21px; } }
    </style>
</head>
<body>
    <nav>
        <a class="nav-logo" href="/" aria-label="Vireflow">
          <img class="logo-full" src="/uploads/logo-lockup.svg" alt="Vireflow">
          <img class="logo-mark" src="/uploads/logo-mark.svg" alt="Vireflow">
        </a>
        <div class="nav-links">
            <a href="/">ИИ-менеджеры</a>
            <a href="/sites/">Сайты</a>
            <a href="/blog/" aria-current="page">Блог</a>
        </div>
        <a class="nav-cta" href="/#contact">Обсудить автоматизацию</a>
        <button class="nav-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" onclick="var n=this.closest('nav');var open=n.classList.toggle('menu-open');this.setAttribute('aria-expanded',open?'true':'false');this.textContent=open?'✕':'☰';">☰</button>
    </nav>

    <article class="article-container">
        <h1>{{ title }}</h1>
        <p class="article-date">{{ page.date | ruDate }} · Елена Мишарина</p>

        {{ content | safe }}

        <div class="cta-box">
            <p>{{ cta or "Расскажите о своей задаче — отвечу, что подойдёт и сколько это будет стоить." }}</p>
            <a href="{{ ctaLink or '/#contact' }}">{{ ctaButton or "Обсудить задачу" }}</a>
        </div>

        <div class="read-more">
            <h2>Читайте также</h2>
            <ul>
            {% for post in collections.blog %}{% if post.url != page.url and loop.index0 < 5 %}
                <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
            {% endif %}{% endfor %}
            </ul>
        </div>

        <div class="back-link"><a href="/blog/">← Все статьи</a></div>
    </article>

    <footer>
      <div class="footer-info">
        <span class="footer-copy">© 2025–{{ currentYear }} {{ footer.copy }}</span>
        <span class="footer-legal">{{ footer.legalName }} · ИНН {{ footer.inn }} · ОГРНИП {{ footer.ogrnip }}</span>
      </div>
      <a class="footer-link" href="/privacy-policy.html">Политика конфиденциальности</a>
    </footer>

{% include "metrika.njk" %}
</body>
</html>
