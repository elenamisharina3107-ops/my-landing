<body>

<nav>
  <a class="nav-logo" href="#">{{ about.name }}</a>
  <div class="nav-links">
    <a href="#benefits">Услуги</a>
    <a href="#process">Процесс</a>
    <a href="#prices">Цены</a>
    <a href="#faq">FAQ</a>
    <a href="/blog/">Блог</a>
  </div>
  <a class="nav-cta" href="#contact">Получить сайт</a>
</nav>

<!-- HERO -->
<section style="padding: 80px 40px 72px; background: #080d1a;">
  <div class="hero container" style="padding: 0;">
    <div>
      <div class="hero-badge"><div class="hero-badge-dot"></div>{{ hero.badge }}</div>
      <h1>{{ hero.titleBefore }}<span>{{ hero.titleAccent }}</span></h1>
      <p class="hero-sub">{{ hero.subtitle }}</p>
      <div class="hero-btns">
        <a class="btn-primary" href="#contact">{{ hero.primaryButtonText }}</a>
        <a class="btn-ghost" href="#prices">{{ hero.ghostButtonText }}</a>
      </div>
      <div class="hero-stats">
        {% for stat in hero.stats %}
        <div><div class="stat-num">{{ stat.num }}</div><div class="stat-label">{{ stat.label }}</div></div>
        {% endfor %}
      </div>
    </div>
    <div class="hero-visual">
      <div class="browser-bar">
        <div class="dot" style="background:#1a2545"></div>
        <div class="dot" style="background:#1a2545"></div>
        <div class="dot" style="background:#4a9eff"></div>
        <div class="browser-url"></div>
      </div>
      <div class="browser-screen">
        <div class="mock-heading"></div>
        <div class="mock-text" style="width:88%"></div>
        <div class="mock-text" style="width:72%"></div>
        <div class="mock-btn"></div>
        <div class="mock-cards">
          <div class="mock-card"><div class="mock-icon"></div><div class="mock-line"></div><div class="mock-line" style="width:60%"></div></div>
          <div class="mock-card"><div class="mock-icon accent"></div><div class="mock-line"></div><div class="mock-line" style="width:60%"></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAIN -->
<section class="section-alt" id="services">
  <div class="container">
    <div class="section-label">{{ pain.label }}</div>
    <div class="section-title">{{ pain.title }}</div>
    <p class="section-sub">{{ pain.subtitle }}</p>
    <div class="pain-grid">
      {% for card in pain.cards %}
      <div class="pain-card">
        <div class="pain-icon">{{ card.icon }}</div>
        <div class="pain-title">{{ card.title }}</div>
        <p class="pain-text">{{ card.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- BENEFITS -->
<section id="benefits">
  <div class="container">
    <div class="section-label">{{ benefits.label }}</div>
    <div class="section-title">{{ benefits.title }}</div>
    <p class="section-sub">{{ benefits.subtitle }}</p>
    <div class="benefits-grid">
      {% for item in benefits.items %}
      <div class="benefit-item"><div class="benefit-icon">{{ item.icon }}</div><div><div class="benefit-title">{{ item.title }}</div><p class="benefit-text">{{ item.text }}</p></div></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- PROCESS + INCLUDES -->
<section class="section-alt" id="process">
  <div class="container">
    <div class="two-col">
      <div>
        <div class="section-label">{{ process.label }}</div>
        <div class="section-title">{{ process.title }}</div>
        <div class="process-steps">
          {% for step in process.steps %}
          <div class="process-step"><div class="step-num">{{ loop.index }}</div><div><div class="step-title">{{ step.title }}</div><p class="step-text">{{ step.text }}</p></div></div>
          {% endfor %}
        </div>
      </div>
      <div>
        <div class="section-label">{{ process.includesLabel }}</div>
        <div class="section-title">{{ process.includesTitle }}</div>
        <div class="includes-list">
          {% for inc in process.includes %}
          <div class="include-item"><div class="include-check">✦</div><div><div class="include-title">{{ inc.title }}</div><p class="include-text">{{ inc.text }}</p></div></div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- NEURO -->
<section>
  <div class="container">
    <div class="section-label">{{ neuro.label }}</div>
    <div class="section-title">{{ neuro.title }}</div>
    <p class="section-sub">{{ neuro.subtitle }}</p>
    <div class="neuro-flow">
      {% for node in neuro.flow %}
      <div class="neuro-node{% if node.active %} active{% endif %}">{{ node.text }}</div>
      {% if not loop.last %}<div class="neuro-arrow">→</div>{% endif %}
      {% endfor %}
    </div>
    <div class="neuro-cards">
      {% for card in neuro.cards %}
      <div class="neuro-card"><div class="neuro-card-icon">{{ card.icon }}</div><div class="neuro-card-title">{{ card.title }}</div><p class="neuro-card-text">{{ card.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="section-alt">
  <div class="container">
    <div class="section-label">{{ about.label }}</div>
    <div class="about-wrap">
      <div class="about-photo">
        <img src="{{ about.photo }}" alt="{{ about.photoAlt }}">
      </div>
      <div>
        <div class="about-name">{{ about.name }}</div>
        <div class="about-role">{{ about.role }}</div>
        <p class="about-text">{{ about.text | safe }}</p>
        <div class="about-tags">
          {% for tag in about.tags %}
          <span class="about-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- GUARANTEE -->
<section>
  <div class="container">
    <div class="section-label">{{ guarantee.label }}</div>
    <div class="section-title">{{ guarantee.title }}</div>
    <div class="guarantee-box">
      {% for item in guarantee.items %}
      <div><div class="guarantee-icon">{{ item.icon }}</div><div class="guarantee-title">{{ item.title }}</div><p class="guarantee-text">{{ item.text }}</p></div>
      {% endfor %}
      <div class="guarantee-note">{{ guarantee.note }}</div>
    </div>
  </div>
</section>

<!-- PRICES -->
<section class="section-alt" id="prices">
  <div class="container">
    <div class="section-label">{{ prices.label }}</div>
    <div class="section-title">{{ prices.title }}</div>
    <div class="prices-grid">
      {% for tariff in prices.items %}
      <div class="price-card{% if tariff.featured %} featured{% endif %}">
        {% if tariff.badge %}<div class="price-badge">{{ tariff.badge }}</div>{% endif %}
        <div class="price-name">{{ tariff.name }}</div>
        <div class="price-new">{{ tariff.price }}</div>
        <div class="price-period">{{ tariff.period }}</div>
        <div class="price-divider"></div>
        {% for feature in tariff.features %}
        <div class="price-feature"><span class="price-check">✦</span> {{ feature }}</div>
        {% endfor %}
        <div style="font-size: 12px; color: #8B8B9E; margin-top: 12px; padding-top: 12px; border-top: 1px solid #1a2545;">{{ tariff.monthlyNote }}</div>
        <a class="price-btn{% if tariff.featured %} featured-btn{% endif %}" href="#contact" onclick="selectTariff('{{ tariff.name }} — {{ tariff.price }}')">{{ tariff.buttonText }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq">
  <div class="container">
    <div class="section-label">Вопросы и ответы</div>
    <div class="section-title">Часто спрашивают</div>
    <div class="faq-list">
      {% for item in collections.faq %}
      <div class="faq-item{% if loop.first %} open{% endif %}"><div class="faq-q">{{ item.data.question }} <span class="faq-toggle">+</span></div><div class="faq-a">{{ item.templateContent | safe }}</div></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section" id="contact">
  <div class="cta-title">{{ contact.title }}</div>
  <p class="cta-sub">{{ contact.subtitle }}</p>
  <div class="cta-form">
    <div id="form-success" style="display:none; background:#0f1428; border:1px solid #1a2545; border-radius:12px; padding:20px; margin-bottom:16px; color:#4a9eff; font-size:15px; line-height:1.6;">✅ Заявка отправлена! Свяжусь с вами в ближайшее время.</div>
    <div id="selected-tariff" style="display:none; background:#0f1428; border:1px solid #4a9eff; border-radius:12px; padding:14px 18px; margin-bottom:12px; color:#4a9eff; font-size:14px; text-align:left;">
      <span style="color:#8B8B9E; font-size:12px;">Выбранный тариф:</span><br>
      <strong id="tariff-name"></strong>
      <span onclick="clearTariff()" style="float:right; cursor:pointer; color:#8B8B9E; font-size:18px; line-height:1;">×</span>
    </div>
    <form id="contact-form" action="https://formspree.io/f/mjgdaryr" method="POST">
      <input class="cta-input" type="text" name="name" placeholder="Ваше имя" required>
      <input class="cta-input" type="text" name="contact" id="f-contact" placeholder="Telegram / email / телефон" required>
      <div id="contact-error" style="display:none; color:#F87171; font-size:13px; text-align:left; margin:-6px 0 10px 4px;">Укажите телефон, email или Telegram (например: @username, +7 900 123-45-67 или mail@mail.ru)</div>
      <input class="cta-input" type="text" name="message" placeholder="Расскажите о задаче (необязательно)">
      <input type="hidden" name="tariff" id="f-tariff" value="Не выбран">
      <input type="hidden" name="_subject" value="Новая заявка с сайта — Елена Мишарина">
      <input type="hidden" name="consent_given_at" id="f-consent-time">

      <label style="display:flex; align-items:flex-start; gap:8px; text-align:left; font-size:13px; color:#8B8B9E; margin:14px 0 4px;">
        <input type="checkbox" id="f-consent" style="margin-top:3px;">
        <span>Даю согласие на обработку персональных данных в соответствии с <a href="/privacy-policy.html" target="_blank" style="color:#4a9eff;">Политикой конфиденциальности</a></span>
      </label>
      <div id="consent-error" style="display:none; color:#F87171; font-size:13px; text-align:left; margin:0 0 10px 4px;">Нужно подтвердить согласие на обработку данных</div>

      <label style="display:flex; align-items:flex-start; gap:8px; text-align:left; font-size:13px; color:#8B8B9E; margin:0 0 14px;">
        <input type="checkbox" id="f-marketing" name="marketing_consent">
        <span>Хочу получать полезные материалы и предложения по email/Telegram</span>
      </label>

      <button class="cta-btn" type="submit">{{ hero.primaryButtonText }}</button>
    </form>
  </div>
  <div class="cta-divider"><div class="cta-divider-line"></div><span class="cta-divider-text">или напишите напрямую</span><div class="cta-divider-line"></div></div>
  <div class="cta-socials">
    <a class="social-link" href="{{ contact.telegram }}" target="_blank">✈️ Telegram</a>
    <a class="social-link" href="{{ contact.vk }}" target="_blank">💬 VK</a>
    <a class="social-link" href="mailto:{{ contact.email }}">✉️ {{ contact.email }}</a>
  </div>
</section>

<footer>
  <span class="footer-copy">{{ footer.copy }}</span>
  <a class="footer-link" href="/privacy-policy.html">Политика конфиденциальности</a>
</footer>

<script>
document.querySelectorAll(".faq-item").forEach(function(item) {
  item.querySelector(".faq-q").addEventListener("click", function() {
    var isOpen = item.classList.contains("open");
    document.querySelectorAll(".faq-item").forEach(function(i) { i.classList.remove("open"); });
    if (!isOpen) item.classList.add("open");
  });
});

function selectTariff(name) {
  document.getElementById("f-tariff").value = name;
  document.getElementById("tariff-name").textContent = name;
  document.getElementById("selected-tariff").style.display = "block";
}

function clearTariff() {
  document.getElementById("f-tariff").value = "Не выбран";
  document.getElementById("selected-tariff").style.display = "none";
}

var tgRe = /^@[a-zA-Z0-9_]{5,32}$/;
var tgLinkRe = /^(https?:\/\/)?(t\.me|telegram\.me)\/[a-zA-Z0-9_]{5,32}$/;
var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
var phoneRe = /^(\+7|8|7)?[\s\-]?\(?\d{3}\)?[\s\-]?\d{3}[\s\-]?\d{2}[\s\-]?\d{2}$/;

function isValidContact(value) {
  return emailRe.test(value) || phoneRe.test(value) || tgRe.test(value) || tgLinkRe.test(value);
}

function updateButtonState() {
  var btn = document.querySelector('.cta-btn');
  var consentInput = document.getElementById('f-consent');

  if (consentInput.checked) {
    btn.disabled = false;
    btn.style.opacity = '1';
    btn.style.cursor = 'pointer';
  } else {
    btn.disabled = true;
    btn.style.opacity = '0.5';
    btn.style.cursor = 'not-allowed';
  }
}

document.getElementById('f-consent').addEventListener('change', updateButtonState);
document.addEventListener('DOMContentLoaded', updateButtonState);

document.getElementById("contact-form").addEventListener("submit", function(e) {
  e.preventDefault();
  var form = e.target;
  var contactInput = document.getElementById("f-contact");
  var errorDiv = document.getElementById("contact-error");
  var consentInput = document.getElementById("f-consent");
  var consentError = document.getElementById("consent-error");

  if (!isValidContact(contactInput.value)) {
    errorDiv.style.display = "block";
    contactInput.style.borderColor = "#F87171";
    contactInput.focus();
    return;
  }
  errorDiv.style.display = "none";
  contactInput.style.borderColor = "#1a2545";

  if (!consentInput.checked) {
    consentError.style.display = "block";
    return;
  }
  consentError.style.display = "none";

  document.getElementById("f-consent-time").value = new Date().toISOString();
  var btn = form.querySelector('button[type="submit"]');
  btn.textContent = "Отправляем...";
  btn.disabled = true;

  // Дубль на Formspree — оттуда приходит письмо о заявке (CORS у него настроен).
  fetch("https://formspree.io/f/mjgdaryr", {
    method: "POST",
    headers: { "Accept": "application/json" },
    body: new FormData(form)
  }).catch(function () {});

  // Основной канал — Google Таблица через Apps Script.
  // mode:"no-cors" обязателен: ответ Apps Script идёт через редирект без CORS-заголовков,
  // поэтому прочитать res нельзя. Запрос при этом доходит и пишется в таблицу,
  // так что резолв промиса считаем успехом.
  fetch("https://script.google.com/macros/s/AKfycbwuaWa3x0EywWH3_WSDOVT-rvRJktaUTIzvIWv2_YqD_vY8S5od4X7qdMuKK3YDU-tV5A/exec", {
    method: "POST",
    mode: "no-cors",
    headers: { "Content-Type": "text/plain;charset=UTF-8" },
    body: JSON.stringify({
      name: form.name.value,
      contact: form.contact.value,
      tariff: form.tariff.value,
      message: form.message.value,
      consent_given_at: form.consent_given_at.value,
      marketing_consent: form.marketing_consent.checked
    })
  }).then(function () {
    form.style.display = "none";
    document.getElementById("form-success").style.display = "block";
  }).catch(function (err) {
    console.error("Lead submission failed:", err);
    btn.textContent = "Получить сайт под заявки";
    btn.disabled = false;
  });
});

</script>

