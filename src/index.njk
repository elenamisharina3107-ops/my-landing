<!-- ALYONA CHAT WIDGET -->
<div id="alyona-widget">
  <div class="alyona-chat" id="alyona-chat-window">
    <div class="alyona-header">
      <div class="alyona-avatar">🤖</div>
      <div class="alyona-header-text">
        <div class="alyona-header-name">Алёна, ассистент</div>
        <div class="alyona-header-status">на связи</div>
      </div>
    </div>
    <div class="alyona-messages" id="alyona-messages"></div>
    <div class="alyona-input-row">
      <input id="alyona-input" type="text" placeholder="Напишите сообщение..." autocomplete="off">
      <button id="alyona-send" aria-label="Отправить">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </div>
  </div>
  <div class="alyona-teaser" id="alyona-teaser">
  Здесь можно спросить всё, что интересует — отвечаю быстро 👋
  <div class="alyona-teaser-close" id="alyona-teaser-close">✕</div>
</div> <button id="alyona-toggle" aria-label="Открыть чат с Алёной">
    <svg class="alyona-icon-chat" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
    <svg class="alyona-icon-close" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    <span class="alyona-badge-dot"></span>
  </button>
</div>

<script>
(function() {
  var API_BASE = "https://api.vireflow.ru";
  var widget = document.getElementById("alyona-widget");
  var toggleBtn = document.getElementById("alyona-toggle");
  var messagesEl = document.getElementById("alyona-messages");
  var inputEl = document.getElementById("alyona-input");
  var sendBtn = document.getElementById("alyona-send");

  var sessionId = null;
  var started = false;
  var sending = false;
  var teaser = document.getElementById("alyona-teaser");
  var teaserClose = document.getElementById("alyona-teaser-close");
  var teaserTimeout;

  function showTeaser() {
    if (widget.classList.contains("open")) return;
    teaser.classList.add("show");
    teaserTimeout = setTimeout(function() { teaser.classList.remove("show"); }, 10000);
  }

  function hideTeaser() {
    teaser.classList.remove("show");
    clearTimeout(teaserTimeout);
  }

  setTimeout(showTeaser, 4000);

  teaser.addEventListener("click", function() {
    hideTeaser();
    toggleBtn.click();
  });

  teaserClose.addEventListener("click", function(e) {
    e.stopPropagation();
    hideTeaser();
  });

  function addMessage(text, role) {
    var el = document.createElement("div");
    el.className = "alyona-msg " + role;
    el.textContent = text;
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function showTyping() {
    var el = document.createElement("div");
    el.className = "alyona-typing";
    el.id = "alyona-typing-indicator";
    el.innerHTML = "<span></span><span></span><span></span>";
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function hideTyping() {
    var el = document.getElementById("alyona-typing-indicator");
    if (el) el.remove();
  }

  function startChat() {
    if (started) return;
    started = true;
    showTyping();
    fetch(API_BASE + "/api/chat/start", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({})
    }).then(function(res) {
      if (!res.ok) throw new Error("bad status");
      return res.json();
    }).then(function(data) {
      hideTyping();
      sessionId = data.session_id;
      addMessage(data.greeting || "Здравствуйте! Чем могу помочь?", "bot");
    }).catch(function() {
      hideTyping();
      addMessage("Не получилось подключиться к чату. Попробуйте обновить страницу или напишите нам в Telegram.", "error");
      started = false;
    });
  }

  function sendMessage() {
    var text = inputEl.value.trim();
    if (!text || sending || !sessionId) return;
    sending = true;
    sendBtn.disabled = true;
    addMessage(text, "user");
    inputEl.value = "";
    showTyping();
    fetch(API_BASE + "/api/chat/message", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session_id: sessionId, text: text })
    }).then(function(res) {
      if (!res.ok) throw new Error("bad status");
      return res.json();
    }).then(function(data) {
      hideTyping();
      addMessage(data.reply || "...", "bot");
    }).catch(function() {
      hideTyping();
      addMessage("Не получилось отправить, попробуйте ещё раз.", "error");
    }).finally(function() {
      sending = false;
      sendBtn.disabled = false;
      inputEl.focus();
    });
  }

  toggleBtn.addEventListener("click", function() {
    hideTeaser();
    var isOpen = widget.classList.toggle("open");
    if (isOpen) {
      startChat();
      setTimeout(function() { inputEl.focus(); }, 150);
    }
  });

  sendBtn.addEventListener("click", sendMessage);
  inputEl.addEventListener("keydown", function(e) {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
})();
</script>

<script>
// REVEAL ON SCROLL + BRIGHTNESS EFFECT
(function() {
  var revealSelector = '.pain-card, .benefit-item, .price-card, .faq-item, .include-item, .process-step, .neuro-card, .neuro-flow, .guarantee-box, .guarantee-note, .about-wrap, .section-title, .section-sub, .section-label';

  function initReveal() {
    var elements = document.querySelectorAll(revealSelector);
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      elements.forEach(function(el) { observer.observe(el); });
    } else {
      elements.forEach(function(el) { el.classList.add('visible'); });
    }
  }

  function updateScrollBrightness() {
    var blocks = document.querySelectorAll(revealSelector);
    var viewportCenter = window.innerHeight / 2;
    blocks.forEach(function(block) {
      var rect = block.getBoundingClientRect();
      var elementCenter = rect.top + rect.height / 2;
      var distance = Math.abs(elementCenter - viewportCenter);
      var maxDistance = window.innerHeight * 0.6;
      var brightness = Math.max(0.35, 1 - (distance / maxDistance) * 0.65);
      block.style.filter = 'brightness(' + brightness + ')';
    });
  }

  function init() {
    initReveal();
    updateScrollBrightness();
    window.addEventListener('scroll', updateScrollBrightness, { passive: true });
    window.addEventListener('resize', updateScrollBrightness);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

