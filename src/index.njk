<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Елена Мишарина — Vireflow",
  "url": "https://vireflow.ru/",
  "description": "Создание лидогенерирующих сайтов, Telegram Mini Apps, чат-ботов и AI-агентов для бизнеса.",
  "sameAs": [
    "https://t.me/el_misharina",
    "https://vk.com/elenamisharina"
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in collections.faq %}
    {"@type":"Question","name":{{ item.data.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.templateContent | striptags | trim | dump | safe }}}}{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<link rel="icon" href="/uploads/favicon.svg?v=2" type="image/svg+xml">
<link rel="icon" href="/uploads/favicon-96.png?v=2" sizes="96x96" type="image/png">
